// Facebook Comment Auto-Reply Bot
// Listens for new comments on your Facebook Page, generates an AI reply
// using Google Gemini, and posts the reply back automatically.

const express = require("express");
const axios = require("axios");

const app = express();
app.use(express.json());

// ---- CONFIG (set these as Environment Variables on Railway/Render) ----
const VERIFY_TOKEN = process.env.VERIFY_TOKEN;       // any string you make up, used to verify the webhook
const PAGE_ACCESS_TOKEN = process.env.PAGE_ACCESS_TOKEN;
const GEMINI_API_KEY = process.env.GEMINI_API_KEY;
const PAGE_ID = process.env.PAGE_ID;

// Your bot's personality / instructions - edit this freely
const SYSTEM_PROMPT = `You are replying to comments on a Facebook Page.
Tone: friendly, professional, and occasionally funny.
Keep replies short (1-3 sentences), natural, and never robotic-sounding.
Do not make promises about pricing, refunds, or policies you don't know about.
If a comment is a complaint or sounds angry, reply briefly and kindly,
and ask them to send a direct message so it can be handled personally.`;

// ---- 1. Webhook verification (Facebook calls this once when you set up the webhook) ----
app.get("/webhook", (req, res) => {
  const mode = req.query["hub.mode"];
  const token = req.query["hub.verify_token"];
  const challenge = req.query["hub.challenge"];

  if (mode === "subscribe" && token === VERIFY_TOKEN) {
    console.log("Webhook verified");
    res.status(200).send(challenge);
  } else {
    res.sendStatus(403);
  }
});

// ---- 2. Webhook receiver (Facebook calls this every time there's a new comment) ----
app.post("/webhook", async (req, res) => {
  // Respond immediately so Facebook doesn't retry/timeout
  res.status(200).send("EVENT_RECEIVED");

  try {
    const body = req.body;
    if (body.object !== "page") return;

    for (const entry of body.entry || []) {
      for (const change of entry.changes || []) {
        if (change.field === "feed" && change.value?.item === "comment") {
          const value = change.value;

          // Ignore comments made by the Page itself (avoid replying to our own replies)
          if (value.from?.id === PAGE_ID) continue;

          // Only handle new comment additions
          if (value.verb !== "add") continue;

          const commentId = value.comment_id;
          const commentText = value.message;

          if (!commentText || !commentId) continue;

          console.log("New comment:", commentText);

          const replyText = await generateReply(commentText);
          if (replyText) {
            await postReply(commentId, replyText);
            console.log("Replied:", replyText);
          }
        }
      }
    }
  } catch (err) {
    console.error("Error handling webhook event:", err.message);
  }
});

// ---- 3. Generate a reply using Gemini ----
async function generateReply(commentText) {
  try {
    const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${GEMINI_API_KEY}`;

    const response = await axios.post(url, {
      contents: [
        {
          parts: [
            {
              text: `${SYSTEM_PROMPT}\n\nComment: "${commentText}"\n\nReply:`,
            },
          ],
        },
      ],
    });

    const text = response.data?.candidates?.[0]?.content?.parts?.[0]?.text;
    return text ? text.trim() : null;
  } catch (err) {
    console.error("Gemini API error:", err.response?.data || err.message);
    return null;
  }
}

// ---- 4. Post the reply back to Facebook ----
async function postReply(commentId, message) {
  try {
    const url = `https://graph.facebook.com/v19.0/${commentId}/comments`;
    await axios.post(url, {
      message,
      access_token: PAGE_ACCESS_TOKEN,
    });
  } catch (err) {
    console.error("Facebook post error:", err.response?.data || err.message);
  }
}

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`Bot server running on port ${PORT}`));
